{
  "mcpServers": {
    "gitHubMcp": {
      "url": "https://fittable-deeanna-noneditorially.ngrok-free.dev/mcp",
      "headers": {
        "ngrok-skip-browser-warning": "true"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "commands": {
      "command": "npx",
      "args": ["-y", "mcp-server-commands"]
    }
  }
}
