# OpenRouter API Key (обязательно!)
# Получите ключ на https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database URL
# По умолчанию используется H2 (файловая БД)
DATABASE_URL=jdbc:h2:./data/weather_db;AUTO_SERVER=TRUE

# Для PostgreSQL (production):
# DATABASE_URL=jdbc:postgresql://localhost:5432/weather_db?user=weatherapp&password=your_password

# Server Port (опционально, по умолчанию 8080)
# SERVER_PORT=8080
